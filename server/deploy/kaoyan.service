[Unit]
Description=Kaoyan Study Timer
After=network.target

[Service]
Type=simple
User=kaoyan
Group=kaoyan
WorkingDirectory=/opt/kaoyan/server
EnvironmentFile=/opt/kaoyan/server/.env
ExecStart=/opt/kaoyan/server/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 --access-logfile - wsgi:app
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
